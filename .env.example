# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Restrict the OAuth consent screen / client to the kunomura.com Workspace.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAIN=kunomura.com

# NextAuth
NEXTAUTH_URL=https://dipquo.kunomura.com
NEXTAUTH_SECRET=

# GitHub data store (auryu-cyber/dipquo-data).
# Use a fine-grained PAT or GitHub App installation token scoped to dipquo-data only —
# never a token with access to other repositories.
GITHUB_DATA_TOKEN=
GITHUB_DATA_OWNER=auryu-cyber
GITHUB_DATA_REPO=dipquo-data
GITHUB_DATA_BRANCH=main
